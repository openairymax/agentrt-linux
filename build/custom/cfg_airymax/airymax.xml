<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: GPL-2.0-only
  AirymaxOS imageTailor image-content descriptor.
  Reuses openEuler imageTailor; only the package list + repo ref are overridden.
  See docs-closed/agentrt-linux/01-openeuler-tech-reference/12-build-and-flash-strategy.md §2.1
-->
<image name="airymax">
    <!-- Repository descriptor: AirymaxOS dnf repo layout (see airymax-repo.xml / §3.1) -->
    <repo repoID="airymax-os" repoName="AirymaxOS 1.0.1" repoFile="airymax-repo.xml"/>

    <!-- Base filesystem: openEuler 24.03 LTS base packages, reused unmodified -->
    <packagegroup name="base">
        <package name="bash"/>
        <package name="glibc"/>
        <package name="glibc-common"/>
        <package name="systemd"/>
        <package name="openssh"/>
        <package name="openssh-server"/>
        <package name="dnf"/>
        <package name="NetworkManager"/>
    </packagegroup>

    <!-- AirymaxOS kernel stack (self-built per airy-kernel.spec §1.2) -->
    <packagegroup name="airy-kernel-stack">
        <package name="airy-kernel"/>
        <package name="airy-kernel-modules"/>
        <package name="airy-kernel-devel"/>
        <package name="airy-kernel-headers"/>
    </packagegroup>

    <!-- AirymaxOS userspace + Web UI (Layer 0 per §5.1) -->
    <packagegroup name="airy-userspace">
        <package name="airy-lsm-tools"/>
        <package name="airy-sc-toolchain"/>
        <package name="cockpit"/>
        <package name="cockpit-airymax"/>
    </packagegroup>

    <bootloader name="grub2" config="boot/grub.cfg"/>
</image>
